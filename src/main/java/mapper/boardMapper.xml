<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <!-- namespace : mapper DAO를 연결하기 위한 이름 -->
<mapper namespace="boardMapper">
	<!-- SQL 구문 작성 -->
	<!-- id : sql 구문을 구분하는 id -->
	<!-- daoImpl => namespace.id => 어느 mapper에서 어떤 sql을 실행할지 설정 -->
	<!-- parameterType ="들어오는 개체명"(생략가능) / resultType="나갈 객체의 타입" -->
	
	<insert id="add" parameterType="domain.Board">
		insert into board(title, writer, contents, imagefile) 
			values(#{title}, #{writer}, #{contents}, #{imagefile})
	</insert>
	
	<select id="list" resultType="domain.Board">
		select * from board order by bno desc
	</select>
	
	<select id="detail" resultType="domain.Board">
		select * from board where bno = #{bno}
	</select>
	
	<update id="update" >
		update board set title = #{title}, contents= #{contents}, moddate=now()
			where bno = #{bno}
	</update>
	
	<delete id="del">
		delete from board where bno = #{bno}
	</delete>
	
	<select id="paging" resultType="domain.Board">
		select * from board 
		<include refid="search"></include>	
		order by bno desc limit #{pageIndex}, #{qty}  
	</select>
	
	<select id="cnt" resultType="int">
		select count(bno) from board
		<include refid="search"></include>
	</select>
	
	<!-- SQL은 메서드처럼 조각으로 별도 설정해놓을 수 있음. / 필요시 호출 가능 -->
	<sql id="search">
		<if test="type != null">
			<trim prefix="where (" suffix=")" suffixOverrides="or">
				<foreach collection="typeToArray" item="type">
					<trim suffix="or">
						<choose>
							<when test="type.equals('t'.toString())">
								title like concat('%', #{keyword}, '%')
							</when>
							<when test="type.equals('w'.toString())">
								writer like concat('%', #{keyword},'%')
							</when>
							<when test="type.equals('c'.toString())">
								contents like concat('%', #{keyword},'%')
							</when>
						</choose>
					</trim>			
				</foreach>
			</trim>
		</if>
	</sql>
	
	
<!--   
	<select id="selectBlog" resultType="Blog">
    select * from Blog where id = #{id}
  </select> 
  -->
</mapper>